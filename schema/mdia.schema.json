{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdia.local/schema/1.0",
  "title": "MDIA extraction result",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "source",
    "processing_status",
    "documents",
    "document_links",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "processing_status": {
      "enum": [
        "completed",
        "completed_with_review",
        "completed_with_errors"
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Document"
      }
    },
    "document_links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "page_info": {
      "type": "array"
    },
    "summary": {
      "type": "object"
    }
  },
  "$defs": {
    "FieldValue": {
      "type": "object",
      "description": "One extracted field. raw = text exactly as printed; value = normalised value (null when not found/ambiguous); corrected_value only present after a human correction.",
      "required": [
        "raw",
        "value",
        "evidence_id",
        "page",
        "confidence",
        "status",
        "verification"
      ],
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "extracted",
            "not_found",
            "unreadable",
            "ambiguous"
          ]
        },
        "verification": {
          "enum": [
            "unverified",
            "auto_verified",
            "needs_review",
            "corrected",
            "not_applicable"
          ]
        },
        "review_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "corrected_value": {}
      }
    },
    "Evidence": {
      "type": "object",
      "required": [
        "id",
        "document_id",
        "page",
        "text",
        "matched_text",
        "bbox",
        "method",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "page": {
          "type": "integer"
        },
        "text": {
          "type": "string",
          "description": "full source line/row text"
        },
        "matched_text": {
          "type": "string"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x0,y0,x1,y1] relative to page width/height, origin top-left"
        },
        "bboxes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "method": {
          "enum": [
            "text-layer",
            "ocr"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "Warning": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "severity",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "ReviewItem": {
      "type": "object",
      "required": [
        "record_id",
        "field",
        "confidence",
        "reasons"
      ],
      "properties": {
        "record_id": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "confidence": {
          "type": "number"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Document": {
      "type": "object",
      "required": [
        "document_id",
        "document_type",
        "processing_status",
        "patient",
        "provider",
        "invoices",
        "invoice_items",
        "medications",
        "diagnoses",
        "laboratory_tests",
        "imaging",
        "procedures",
        "hospitalization",
        "evidence",
        "warnings",
        "requires_human_review"
      ],
      "properties": {
        "document_id": {
          "type": "string"
        },
        "document_type": {
          "type": "string"
        },
        "processing_status": {
          "enum": [
            "completed",
            "completed_with_review",
            "failed"
          ]
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "patient": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/FieldValue"
            },
            "file_no": {
              "$ref": "#/$defs/FieldValue"
            },
            "insurance_no": {
              "$ref": "#/$defs/FieldValue"
            },
            "age": {
              "$ref": "#/$defs/FieldValue"
            },
            "sex": {
              "$ref": "#/$defs/FieldValue"
            },
            "date_of_birth": {
              "$ref": "#/$defs/FieldValue"
            }
          }
        },
        "provider": {
          "type": "object",
          "properties": {
            "facility_name": {
              "$ref": "#/$defs/FieldValue"
            },
            "doctor": {
              "$ref": "#/$defs/FieldValue"
            },
            "department": {
              "$ref": "#/$defs/FieldValue"
            }
          }
        },
        "hospitalization": {
          "type": "object",
          "properties": {
            "admission_date": {
              "$ref": "#/$defs/FieldValue"
            },
            "discharge_date": {
              "$ref": "#/$defs/FieldValue"
            },
            "length_of_stay_days": {
              "$ref": "#/$defs/FieldValue"
            },
            "room_type": {
              "$ref": "#/$defs/FieldValue"
            },
            "accommodation_cost": {
              "$ref": "#/$defs/FieldValue"
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          }
        },
        "requires_human_review": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewItem"
          }
        },
        "invoices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invoices_record"
          }
        },
        "invoice_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invoice_items_record"
          }
        },
        "medications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/medications_record"
          }
        },
        "diagnoses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnoses_record"
          }
        },
        "laboratory_tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/laboratory_tests_record"
          }
        },
        "imaging": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imaging_record"
          }
        },
        "procedures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/procedures_record"
          }
        }
      }
    },
    "invoices_record": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "unique record id"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "invoice_number": {
          "$ref": "#/$defs/FieldValue"
        },
        "invoice_date": {
          "$ref": "#/$defs/FieldValue"
        },
        "service_date": {
          "$ref": "#/$defs/FieldValue"
        },
        "currency": {
          "$ref": "#/$defs/FieldValue"
        },
        "subtotal": {
          "$ref": "#/$defs/FieldValue"
        },
        "discount_total": {
          "$ref": "#/$defs/FieldValue"
        },
        "tax_total": {
          "$ref": "#/$defs/FieldValue"
        },
        "additional_fees": {
          "$ref": "#/$defs/FieldValue"
        },
        "invoice_total": {
          "$ref": "#/$defs/FieldValue"
        },
        "paid_total": {
          "$ref": "#/$defs/FieldValue"
        },
        "balance_due": {
          "$ref": "#/$defs/FieldValue"
        },
        "patient_share": {
          "$ref": "#/$defs/FieldValue"
        },
        "claimed_total": {
          "$ref": "#/$defs/FieldValue"
        }
      }
    },
    "invoice_items_record": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "unique record id"
        },
        "invoice_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": "integer"
        },
        "line_no": {
          "$ref": "#/$defs/FieldValue"
        },
        "service_name": {
          "$ref": "#/$defs/FieldValue"
        },
        "description": {
          "$ref": "#/$defs/FieldValue"
        },
        "service_type": {
          "$ref": "#/$defs/FieldValue"
        },
        "service_code": {
          "$ref": "#/$defs/FieldValue"
        },
        "service_date": {
          "$ref": "#/$defs/FieldValue"
        },
        "quantity": {
          "$ref": "#/$defs/FieldValue"
        },
        "unit": {
          "$ref": "#/$defs/FieldValue"
        },
        "unit_price": {
          "$ref": "#/$defs/FieldValue"
        },
        "discount": {
          "$ref": "#/$defs/FieldValue"
        },
        "line_total": {
          "$ref": "#/$defs/FieldValue"
        },
        "claimed_amount": {
          "$ref": "#/$defs/FieldValue"
        },
        "paid_amount": {
          "$ref": "#/$defs/FieldValue"
        },
        "patient_share": {
          "$ref": "#/$defs/FieldValue"
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "medications_record": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "unique record id"
        },
        "page": {
          "type": "integer"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "brand_name": {
          "$ref": "#/$defs/FieldValue"
        },
        "generic_name": {
          "$ref": "#/$defs/FieldValue"
        },
        "strength": {
          "$ref": "#/$defs/FieldValue"
        },
        "dosage_form": {
          "$ref": "#/$defs/FieldValue"
        },
        "dose": {
          "$ref": "#/$defs/FieldValue"
        },
        "route": {
          "$ref": "#/$defs/FieldValue"
        },
        "frequency": {
          "$ref": "#/$defs/FieldValue"
        },
        "duration": {
          "$ref": "#/$defs/FieldValue"
        },
        "quantity_prescribed": {
          "$ref": "#/$defs/FieldValue"
        },
        "quantity_dispensed": {
          "$ref": "#/$defs/FieldValue"
        },
        "packs": {
          "$ref": "#/$defs/FieldValue"
        },
        "unit_price": {
          "$ref": "#/$defs/FieldValue"
        },
        "total_price": {
          "$ref": "#/$defs/FieldValue"
        },
        "prescription_date": {
          "$ref": "#/$defs/FieldValue"
        },
        "prescriber": {
          "$ref": "#/$defs/FieldValue"
        },
        "invoice_item_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "diagnoses_record": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "unique record id"
        },
        "page": {
          "type": "integer"
        },
        "entry_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "$ref": "#/$defs/FieldValue"
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "icd10": {
          "$ref": "#/$defs/FieldValue"
        },
        "certainty": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnosis_date": {
          "$ref": "#/$defs/FieldValue"
        },
        "doctor": {
          "$ref": "#/$defs/FieldValue"
        },
        "source_document_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "laboratory_tests_record": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "unique record id"
        },
        "page": {
          "type": "integer"
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_name": {
          "$ref": "#/$defs/FieldValue"
        },
        "result": {
          "$ref": "#/$defs/FieldValue"
        },
        "unit": {
          "$ref": "#/$defs/FieldValue"
        },
        "reference_range": {
          "$ref": "#/$defs/FieldValue"
        },
        "flag": {
          "$ref": "#/$defs/FieldValue"
        },
        "test_date": {
          "$ref": "#/$defs/FieldValue"
        },
        "price": {
          "$ref": "#/$defs/FieldValue"
        }
      }
    },
    "imaging_record": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "unique record id"
        },
        "page": {
          "type": "integer"
        },
        "exam_type": {
          "$ref": "#/$defs/FieldValue"
        },
        "region": {
          "$ref": "#/$defs/FieldValue"
        },
        "findings": {
          "$ref": "#/$defs/FieldValue"
        },
        "exam_date": {
          "$ref": "#/$defs/FieldValue"
        },
        "cost": {
          "$ref": "#/$defs/FieldValue"
        }
      }
    },
    "procedures_record": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "unique record id"
        },
        "page": {
          "type": "integer"
        },
        "procedure_name": {
          "$ref": "#/$defs/FieldValue"
        },
        "procedure_type": {
          "$ref": "#/$defs/FieldValue"
        },
        "code": {
          "$ref": "#/$defs/FieldValue"
        },
        "date": {
          "$ref": "#/$defs/FieldValue"
        },
        "surgeon": {
          "$ref": "#/$defs/FieldValue"
        },
        "surgeon_fee": {
          "$ref": "#/$defs/FieldValue"
        },
        "anesthesia_fee": {
          "$ref": "#/$defs/FieldValue"
        },
        "or_fee": {
          "$ref": "#/$defs/FieldValue"
        },
        "supplies_cost": {
          "$ref": "#/$defs/FieldValue"
        },
        "total_cost": {
          "$ref": "#/$defs/FieldValue"
        }
      }
    }
  }
}
